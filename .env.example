# CrossChain Autonomous Agent — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── EVM RPC Endpoints ────────────────────────────────────────────────────────
# Public endpoints are used as fallbacks if these are not set.
REACT_APP_BASE_RPC_URL=https://mainnet.base.org
REACT_APP_OPTIMISM_RPC_URL=https://mainnet.optimism.io

# ── Stacks Network ───────────────────────────────────────────────────────────
# Options: mainnet | testnet
REACT_APP_STACKS_NETWORK=mainnet
